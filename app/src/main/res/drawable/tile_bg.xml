<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-alone row on the screen background (event rows, add-event form, number entry):
     a plain filled tile with no outline; focused = same single highlight as row_bg. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/ycCellShabbos" />
            <stroke android:width="2dp" android:color="?attr/ycFocus" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/ycCellShabbos" />
            <stroke android:width="2dp" android:color="?attr/ycFocus" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/ycCell" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
