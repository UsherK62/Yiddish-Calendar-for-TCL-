<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded tile: thick focus/activated ring, same language as the month-grid selection. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/ycCellShabbos" />
            <stroke android:width="3dp" android:color="?attr/ycFocus" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/ycCellShabbos" />
            <stroke android:width="3dp" android:color="?attr/ycFocus" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/ycCell" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
