<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="?attr/ycBar" />
    </item>
    <!-- top hairline; negative insets hide the other 3 stroke sides (API 21 safe) -->
    <item android:left="-2dp" android:right="-2dp" android:bottom="-2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="?attr/ycLine" />
        </shape>
    </item>
</layer-list>
