<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen dim. The card wraps its content and sits just above the soft-key bar.
     Long lists scroll inside the card, which is capped in KeyDialog (MaxHeightScrollView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:gravity="bottom"
    android:orientation="vertical">

    <!-- Pushes the card down; the card itself is wrap_content so it is not stretched. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/dlgTitle"
            style="@style/YC.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp" />
        <org.yiddishcalendar.MaxHeightScrollView
            android:id="@+id/dlgScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:overScrollMode="ifContentScrolls"
            android:scrollbarSize="3dp"
            android:scrollbars="vertical">
            <LinearLayout
                android:id="@+id/dlgBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </org.yiddishcalendar.MaxHeightScrollView>
    </LinearLayout>
    <include layout="@layout/softkey_bar" />
</LinearLayout>
