<?xml version="1.0" encoding="utf-8"?>
<!-- One day cell: a tile drawn by DayCellView (numbers, holiday label, event dot), with a 1.5dp gap
     between tiles. The selection ring is drawn by the tile background; content keeps a 3.5-4dp inset. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:focusable="false" android:padding="1.5dp">
    <org.yiddishcalendar.DayCellView android:id="@+id/cellBox"
        android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
