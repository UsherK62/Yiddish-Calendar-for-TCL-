<?xml version="1.0" encoding="utf-8"?>
<!-- Bundled Noto Sans Hebrew (SIL OFL 1.1, see /licenses): clean sans letters, no niqqud needed.
     It has only Hebrew glyphs; Latin text and digits fall back to the system font (Roboto). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- android:* for API 26+, app:* so AppCompat loads the same fonts on Android 5–7. -->
    <font android:font="@font/noto_sans_hebrew_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/noto_sans_hebrew_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/noto_sans_hebrew_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/noto_sans_hebrew_bold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
